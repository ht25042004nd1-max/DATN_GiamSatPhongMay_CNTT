# ============================================================
# .env.example — Mẫu file cấu hình biến môi trường
# Sao chép file này thành ".env" rồi điền giá trị thực vào
# ============================================================

# Flask secret key (dùng để mã hóa session) — đổi thành chuỗi ngẫu nhiên khi deploy
SECRET_KEY=dev-secret-key-change-this-in-production

# Cấu hình database
DATABASE_URL=sqlite:///database/lab_monitor.db

# Cấu hình Telegram Bot (lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=8720358328:AAEVCRwW5XtzcKHTtRwk8Tb0vtZpb-BE3gs
TELEGRAM_CHAT_ID=7982298078

# Cấu hình Camera (0 = webcam mặc định, hoặc đường dẫn file video để test)
CAMERA_SOURCE=0

# Chế độ chạy (development / production)
FLASK_ENV=development
FLASK_DEBUG=True

# Cổng server
FLASK_PORT=5000

# Cấu hình ngưỡng cảnh báo (đơn vị: giây)
# Thời gian tối đa cho phép ngồi sai tư thế trước khi cảnh báo
POSTURE_ALERT_THRESHOLD=10

# Thời gian tối đa phát hiện khói/lửa trước khi cảnh báo
FIRE_ALERT_THRESHOLD=5
